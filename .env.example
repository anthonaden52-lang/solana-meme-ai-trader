# Copy this file to .env
SCAN_INTERVAL=60
MIN_LIQUIDITY_USD=25000
MIN_VOLUME_24H_USD=50000
MIN_TXNS_24H=100
MAX_TOKENS_PER_SCAN=25

# Model settings
HORIZON_MINUTES=15
TARGET_RETURN=0.10
MODEL_THRESHOLD=0.70

# Live trading is intentionally OFF.
LIVE_TRADING=false

# Backtest costs PER SIDE (charged on entry AND exit), fractions: 0.01 = 1%
# Meme-coin slippage is often 2%+ each way.
BACKTEST_FEE=0.005
BACKTEST_SLIPPAGE=0.02
BACKTEST_START_BALANCE=1000
BACKTEST_MAX_POSITIONS=3
BACKTEST_POSITION_FRACTION=0.10

# Keep tracking a token this many minutes after it last passed the filters
TRACK_MINUTES=105
# A gap longer than this restarts indicators for a token
GAP_MINUTES=5

# swap_bot.py limits (never put BOT_PRIVATE_KEY in this file)
MAX_USD=25
MAX_DAILY_USD=100
MAX_FEE_BPS=50
MAX_IMPACT_PCT=3.0
MAX_SLIPPAGE_BPS=100
